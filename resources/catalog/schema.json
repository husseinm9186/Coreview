{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coreview.local/catalog.schema.json",
  "title": "Coreview discovery catalog (one OS)",
  "description": "The shape of resources/catalog/<os>.yaml (LT-512, D-060). Checked by crates/coreview-catalog and by src/lib/catalog.test.ts.",
  "type": "object",
  "required": ["vendor", "os", "name", "phase", "session", "role_hint", "role_defaults", "caps_probe", "commands", "live_path"],
  "additionalProperties": false,
  "properties": {
    "vendor": { "type": "string" },
    "os": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" },
    "ntc_platform": { "type": ["string", "null"] },
    "phase": { "type": "integer", "minimum": 1, "maximum": 4 },
    "note": { "type": "string" },
    "structured_output": { "enum": ["json_pipe", "xml_pipe", "xml_api", "api"] },
    "parser_engine": { "enum": ["sidecar", "rust"], "description": "LT-521: who parses textfsm: commands; rust once shadow mode shows zero mismatches" },
    "fingerprint": {
      "type": ["object", "null"],
      "required": ["probe", "match_regex"],
      "additionalProperties": false,
      "properties": { "probe": { "type": "string" }, "match_regex": { "type": "string" } }
    },
    "session": { "$ref": "#/$defs/session" },
    "role_hint": {
      "type": "array",
      "items": { "type": "object", "required": ["match", "role"], "additionalProperties": false, "properties": { "match": { "type": "string" }, "role": { "$ref": "#/$defs/role" } } }
    },
    "role_defaults": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/flag" } }
    },
    "caps_probe": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "live_path": { "type": "array", "items": { "$ref": "#/$defs/command" } }
  },
  "$defs": {
    "role": { "enum": ["access_switch", "l3_switch", "switch", "router", "firewall", "wlc", "ap", "host", "unknown", "linux-proxmox", "esxi", "windows", "ftd"] },
    "flag": {
      "enum": ["switching", "routing", "vrf", "ospf", "eigrp", "bgp", "isis", "rip", "fhrp", "pbr", "nat", "ipsec", "gre", "dmvpn", "sdwan", "mpls", "vxlan_evpn", "stack", "vss_svl", "vpc_mlag_vsx", "vpc", "ha", "fex", "cdp", "lldp", "wlc", "vdom", "vsys", "multi_context", "structured_output", "fortilink", "advanced_routing", "l2vpn", "fw_zone", "proxmox"]
    },
    "table": {
      "enum": ["device", "interface", "ip_address", "neighbor", "mac_table", "arp", "vlan", "lag", "stp", "vrf", "route", "routing_neighbor", "fhrp", "policy_route", "nat_rule", "fw_zone", "fw_policy", "fw_binding", "fw_object", "tunnel", "ha_pair", "ap", "endpoint", "raw_config", "path_probe", "fib"]
    },
    "parser": {
      "type": "string",
      "description": "textfsm:<template basename> | json | xml | regex | raw | api | none | genie:<name> | reader:<Coreview reader>",
      "pattern": "^(textfsm:[a-z0-9_.-]+|json|xml|regex|raw|api|none|genie:[a-z0-9_]+|reader:[a-z0-9_]+)$"
    },
    "probe": {
      "type": "object",
      "required": ["id", "cmd", "flags", "timeout"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "cmd": { "type": "string" },
        "gate": { "type": "string" },
        "flags": { "type": "object", "propertyNames": { "$ref": "#/$defs/flag" }, "additionalProperties": { "type": "string", "description": "a multiline regex; the flag is set when it matches the probe's output" } },
        "parser": { "$ref": "#/$defs/parser" },
        "timeout": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "cmd", "gate", "parser", "feeds", "verified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "cmd": { "type": "string", "description": "sent as written; {vrf} {vdom} {vsys} {ctx} are filled per foreach; live-path placeholders are filled by the path builder" },
        "gate": { "type": "string", "description": "always | cap.x | role.y | a && b | a || b | !a | (…)" },
        "foreach": { "enum": ["vrf", "vdom", "vsys", "context", "instance"] },
        "context": { "enum": ["global", "system"] },
        "parser": { "$ref": "#/$defs/parser" },
        "also": { "type": "array", "items": { "$ref": "#/$defs/parser" }, "description": "further templates run over the same output" },
        "shadow": { "$ref": "#/$defs/parser", "description": "the parser compared against in Phase 3" },
        "api": { "type": "string", "description": "the REST/XML-API path that answers the same question, used by the Rust API collector" },
        "feeds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/table" } },
        "weight": { "enum": ["light", "heavy"] },
        "timeout": { "type": "integer", "minimum": 1 },
        "verified": { "enum": ["lab", "docs", "unverified"] },
        "evidence": { "type": "string" },
        "coreview_reader": { "type": "boolean" },
        "note": { "type": "string" },
        "phase": { "type": "integer" }
      }
    },
    "session": {
      "type": "object",
      "description": "Prompt, privilege and paging behaviour. Every string sent from here is a literal listed here; the command allowlist is not consulted for session steps, which is why they are the only place a `config` word may appear.",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "prompt_pattern": { "type": "string" },
        "privilege_levels": { "type": "object", "additionalProperties": { "type": "object", "required": ["pattern"], "properties": { "pattern": { "type": "string" }, "escalate": { "type": "string" }, "escalate_auth": { "type": "boolean" }, "escalate_prompt": { "type": "string" }, "previous": { "type": "string" }, "source": { "type": "string" } } } },
        "default_privilege": { "type": "string" },
        "failed_when_contains": { "type": "array", "items": { "type": "string" } },
        "on_open": { "type": "array", "items": { "type": "string" } },
        "on_close": { "type": ["array", "object"] },
        "paging": { "type": "object" },
        "contexts": { "type": "object", "required": ["kind", "detect", "enter", "leave"] },
        "banner": { "type": "object" },
        "login": { "type": "object" },
        "structured": { "type": "object" },
        "ansi": { "type": "object" },
        "strip_context_lines": { "type": "object" }
      }
    }
  }
}
